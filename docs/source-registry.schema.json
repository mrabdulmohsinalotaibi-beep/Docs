{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["$schema", "version", "lastReviewed", "entries"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "lastReviewed": {"type": "string", "format": "date"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "title", "kind", "status", "scope", "publisher", "repositoryPath", "claims", "limitations"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 3},
        "kind": {"type": "string", "minLength": 2},
        "status": {"enum": ["official", "internal", "mixed", "needs-review", "needs-verification", "internal-unvalidated"]},
        "scope": {"type": "string", "minLength": 2},
        "publisher": {"type": "string", "minLength": 2},
        "edition": {"type": ["string", "null"]},
        "repositoryPath": {"type": "string", "minLength": 1},
        "sourceUrl": {"type": ["string", "null"]},
        "pageOrSection": {"type": ["string", "null"]},
        "claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}}
      },
      "additionalProperties": false
    }
  }
}
